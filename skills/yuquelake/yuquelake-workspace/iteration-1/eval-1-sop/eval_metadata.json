{
  "eval_id": 1,
  "eval_name": "sop-refund-conversion",
  "prompt": "帮我把这份退款SOP文档转成语雀Lake格式，我需要导入到知识库里。",
  "assertions": [
    {
      "id": "a1",
      "text": "文件以 <!doctype lake> 开头",
      "type": "regex",
      "pattern": "^<!doctype lake>"
    },
    {
      "id": "a2",
      "text": "包含 <title> 标签",
      "type": "regex",
      "pattern": "<title>.*</title>"
    },
    {
      "id": "a3",
      "text": "包含 4 个 <meta> 标签（doc-version, viewport, typography, paragraphSpacing）",
      "type": "regex",
      "pattern": "<meta name=\"doc-version\".*<meta name=\"viewport\".*<meta name=\"typography\".*<meta name=\"paragraphSpacing\""
    },
    {
      "id": "a4",
      "text": "包含 codeblock card（name=\"codeblock\"）",
      "type": "regex",
      "pattern": "name=\"codeblock\""
    },
    {
      "id": "a5",
      "text": "包含 image card（name=\"image\"）",
      "type": "regex",
      "pattern": "name=\"image\""
    },
    {
      "id": "a6",
      "text": "包含 hr card（name=\"hr\"）",
      "type": "regex",
      "pattern": "name=\"hr\""
    },
    {
      "id": "a7",
      "text": "包含 checkbox card（name=\"checkbox\"）",
      "type": "regex",
      "pattern": "name=\"checkbox\""
    },
    {
      "id": "a8",
      "text": "包含提示框（lake-alert）",
      "type": "regex",
      "pattern": "lake-alert"
    },
    {
      "id": "a9",
      "text": "包含折叠面板（lake-collapse）",
      "type": "regex",
      "pattern": "lake-collapse"
    },
    {
      "id": "a10",
      "text": "包含表格（lake-table）",
      "type": "regex",
      "pattern": "lake-table|<table"
    },
    {
      "id": "a11",
      "text": "无残留伪标签（搜索 card- 前缀应为 0）",
      "type": "negative_regex",
      "pattern": "card-\\w+"
    },
    {
      "id": "a12",
      "text": "所有 card 标签的 value 以 data: 开头",
      "type": "regex",
      "pattern": "value=\"data:"
    }
  ]
}
