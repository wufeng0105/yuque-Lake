<h2>四、数据安全</h2>
<h3>4.1 敏感数据加密</h3>
<table>
<colgroup><col width="266"><col width="266"><col width="266"></colgroup>
<tbody>
<tr><td>字段</td><td>加密方式</td><td>说明</td></tr>
<tr><td>password</td><td>BCrypt(cost=12)</td><td>不可逆加密</td></tr>
<tr><td>phone</td><td>AES-256-ECB</td><td>可逆加密，密钥统一管理</td></tr>
<tr><td>email</td><td>AES-256-ECB</td><td>可逆加密</td></tr>
<tr><td>id_card</td><td>AES-256-ECB</td><td>可逆加密</td></tr>
<tr><td>bank_card</td><td>AES-256-ECB</td><td>可逆加密</td></tr>
</tbody>
</table>
<h3>4.2 数据备份策略</h3>
<table>
<colgroup><col width="200"><col width="200"><col width="200"><col width="200"></colgroup>
<tbody>
<tr><td>备份类型</td><td>频率</td><td>保留时间</td><td>存储位置</td></tr>
<tr><td>全量备份</td><td>每日凌晨2点</td><td>30天</td><td>本地+异地</td></tr>
<tr><td>增量备份</td><td>每小时</td><td>7天</td><td>本地</td></tr>
<tr><td>Binlog备份</td><td>实时</td><td>7天</td><td>本地+异地</td></tr>
<tr><td>逻辑备份</td><td>每周</td><td>90天</td><td>异地</td></tr>
</tbody>
</table>
<card type="block" name="hr" value="data:%7B%22id%22%3A%22Lal70%22%7D"></card>
<h2>五、性能优化</h2>
<h3>5.1 慢查询优化</h3>
<table>
<colgroup><col width="266"><col width="266"><col width="266"></colgroup>
<tbody>
<tr><td>优化类型</td><td>方法</td><td>示例</td></tr>
<tr><td>索引优化</td><td>添加缺失索引</td><td>为order.user_id添加索引</td></tr>
<tr><td>SQL重写</td><td>避免全表扫描</td><td>用JOIN替代子查询</td></tr>
<tr><td>分页优化</td><td>使用游标分页</td><td>WHERE id > last_id LIMIT 20</td></tr>
<tr><td>读写分离</td><td>读走从库</td><td>写主库，读从库</td></tr>
<tr><td>缓存优化</td><td>热数据缓存</td><td>Redis缓存商品信息</td></tr>
</tbody>
</table>
<h3>5.2 连接池配置</h3>
<table>
<colgroup><col width="266"><col width="266"><col width="266"></colgroup>
<tbody>
<tr><td>参数</td><td>值</td><td>说明</td></tr>
<tr><td>initialSize</td><td>5</td><td>初始连接数</td></tr>
<tr><td>minIdle</td><td>10</td><td>最小空闲连接</td></tr>
<tr><td>maxActive</td><td>50</td><td>最大活跃连接</td></tr>
<tr><td>maxWait</td><td>3000ms</td><td>获取连接超时时间</td></tr>
<tr><td>timeBetweenEvictionRunsMillis</td><td>60000ms</td><td>空闲连接检查间隔</td></tr>
<tr><td>minEvictableIdleTimeMillis</td><td>300000ms</td><td>连接最小空闲时间</td></tr>
</tbody>
</table>
<card type="block" name="hr" value="data:%7B%22id%22%3A%225J4Ot%22%7D"></card>
