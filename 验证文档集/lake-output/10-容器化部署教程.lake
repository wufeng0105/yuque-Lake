<h3>6.2 Grafana 仪表盘</h3>
<table>
<colgroup><col width="266"><col width="266"><col width="266"></colgroup>
<tbody>
<tr><td>仪表盘面板</td><td>指标</td><td>查询语句</td></tr>
<tr><td>QPS</td><td>请求速率</td><td>rate(http_requests_total[1m])</td></tr>
<tr><td>响应时间</td><td>P95延迟</td><td>histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))</td></tr>
<tr><td>错误率</td><td>5xx比例</td><td>rate(http_requests_total{status=~"5.."}[1m]) / rate(http_requests_total[1m])</td></tr>
<tr><td>Pod CPU</td><td>CPU使用率</td><td>rate(container_cpu_usage_seconds_total[1m])</td></tr>
<tr><td>Pod内存</td><td>内存使用量</td><td>container_memory_usage_bytes</td></tr>
</tbody>
</table>
