<card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22hideToolbar%22%3Atrue%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22kubectl%20apply%20-f%20https%3A%2F%2Fraw.githubusercontent.com%2Fprojectcalico%2Fcalico%2Fv3.27.0%2Fmanifests%2Fcalico.yaml%22%2C%22heightLimit%22%3Atrue%2C%22id%22%3A%22TWdzZ%22%7D"></card>
